<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:URLFetcher.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="500"
        x:Class="URLFetcher.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="URL Fetcher"
        Width="600"
        Height="500"
        MinWidth="400"
        MinHeight="350">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid Margin="20" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">

        <!-- URL Input -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="URL:" Margin="0,0,0,5" FontWeight="SemiBold"/>
            <TextBox Text="{Binding Url}"
                     Watermark="Enter URL to fetch links from..."
                     IsEnabled="{Binding !IsDownloading}"/>
        </StackPanel>

        <!-- Folder Selection -->
        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="Download Folder:" Margin="0,0,0,5" FontWeight="SemiBold"/>
            <Grid ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0"
                         Text="{Binding SelectedFolder}"
                         IsReadOnly="True"
                         Watermark="Select a folder..."
                         Margin="0,0,10,0"/>
                <Button Grid.Column="1"
                        Content="Browse..."
                        Command="{Binding SelectFolderCommand}"
                        IsEnabled="{Binding !IsDownloading}"
                        Width="100"/>
            </Grid>
        </StackPanel>

        <!-- Download/Cancel Buttons -->
        <Grid Grid.Row="2" Margin="0,0,0,15" ColumnDefinitions="*,Auto">
            <Button Grid.Column="0"
                    Content="Download All Links"
                    Command="{Binding DownloadCommand}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Margin="0,0,10,0"
                    Classes="accent"/>
            <Button Grid.Column="1"
                    Content="Cancel"
                    Command="{Binding CancelCommand}"
                    Width="100"/>
        </Grid>

        <!-- Progress Bar -->
        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <Grid ColumnDefinitions="*,Auto">
                <ProgressBar Grid.Column="0"
                             Value="{Binding Progress}"
                             Minimum="0"
                             Maximum="100"
                             Height="20"
                             Margin="0,0,10,0"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding ProgressText}"
                           VerticalAlignment="Center"
                           Width="80"
                           TextAlignment="Right"/>
            </Grid>
            <TextBlock Text="{Binding StatusText}"
                       Margin="0,5,0,0"
                       FontStyle="Italic"
                       Foreground="Gray"/>
        </StackPanel>

        <!-- Downloaded Files Header -->
        <TextBlock Grid.Row="4"
                   Text="Downloaded Files:"
                   Margin="0,10,0,5"
                   FontWeight="SemiBold"/>

        <!-- Downloaded Files List -->
        <Border Grid.Row="5"
                BorderBrush="Gray"
                BorderThickness="1"
                CornerRadius="4">
            <ListBox ItemsSource="{Binding DownloadedFiles}"
                     Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:DownloadedFileViewModel">
                        <StackPanel Orientation="Horizontal" Margin="5,2">
                            <TextBlock Text="{Binding StatusIcon}"
                                       Width="20"
                                       Foreground="{Binding Success, Converter={x:Static vm:BoolToColorConverter.Instance}}"/>
                            <TextBlock Text="{Binding DisplayText}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</Window>
